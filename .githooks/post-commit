#!/bin/sh
# ──────────────────────────────────────────────────────────────────────────────
# Git post-commit hook · 提交成功后同步「最后已知 HEAD」记录
#
# [2026-09-17 纳入版本控制]
# 本文件原只存在于 .git/hooks/ 下，不受版本控制。现移入 .githooks/ 并
# 配合 `git config core.hooksPath .githooks` 使其成为仓库的一部分。
#
# [为什么需要这个 hook]
# .claude/sync-check.sh 在会话启动时通过比较 .claude/last_known_head 与
# 当前 HEAD 来判断"是否需要检查同步"。
#
# 若**没有** post-commit 来更新该记录，则 HEAD 一经前进（**哪怕是本窗口
# 自己的正常提交**），记录立刻落后 —— 于是每次提交后都会触发一次
# "检测到 HEAD 不一致"的检查。这类必然发生的误报会让人对告警脱敏。
#
# 有了本 hook 后：正常的本窗口提交会同步更新记录，检查只在**确实有外部
# 提交**时才触发。
# ──────────────────────────────────────────────────────────────────────────────

RECORD_FILE=".claude/last_known_head"

if [ ! -f "$RECORD_FILE" ]; then
    exit 0
fi

# ★ 这里必须写**提交后**的 HEAD。
#
# git post-commit 是"提交完成后"的钩子，此时：
#   HEAD                = 刚产生的新提交（正确值）
#   GIT_INDEX_FILE      = 仍然指向"提交前"的临时索引，其中是**父提交**的树
#   git rev-parse HEAD  = 新提交 ✅ （它读 HEAD 引用，不读索引）
#   git rev-parse :0    = 提交前的树
#
# 关键点：新提交刚刚生成，工作树与索引都还是"提交前"的样子，
# 若此处改用 `git stash` / `git add` 之类会触碰索引的命令，就会污染提交后状态。
# 因此这里只做一件事：把新 HEAD 写入记录文件。保持最小副作用。
#
# 实际踩到的坑（2026-09-17）：钩子生效后 `.claude/last_known_head` 永久处于
# "已修改未提交"状态 —— 因为它在每次提交后都会被钩子改写，而提交动作本身
# 无法把这一改动带上。这会让 `sync-check.sh` 的安全性检查 1（工作树干净？）
# **永远判定为"脏"**，从而**永久跳过自动同步**，脚本等于失效。
#
# 处理方式（三选一，本项目采用第一种）：
#   ① 把 .claude/last_known_head 加入 .gitignore，由钩子本地维护；
#   ② 记录文件改放在 .git/ 下（不属于工作树，天然不受 status 影响）；
#   ③ 不再跟踪该文件，改由 sync-check.sh 自行判断。
git rev-parse HEAD > "$RECORD_FILE" 2>/dev/null

exit 0
