#!/bin/sh
# ──────────────────────────────────────────────────────────────────────────────
# Git pre-commit hook · 提交前拦截
#
# [2026-09-17 纳入版本控制 + 清理]
# 本文件原先只存在于 .git/hooks/pre-commit —— **不受版本控制**，换机器或
# 重新 clone 后即失效，且无法被他人获取。现移入 .githooks/ 并配合
#   git config core.hooksPath .githooks
# 使其成为仓库的一部分。
#
# 同时删除了两处问题：
#
# 1. **多窗口误报分支（原第 8~31 行）**
#    原逻辑比较 .claude/last_known_head 与当前 HEAD，不等就判定
#    "其他窗口已提交了新代码"并阻止提交。但 HEAD 前进的最常见原因
#    **就是本窗口自己刚提交过** —— 该分支几乎必然误报，且提示文案
#    「以下文件已被其他窗口修改」实际来自 git diff LAST..HEAD，
#    列出的是**自己已提交的历史**，属明显误导。
#    真正的多窗口同步检查已由 .claude/sync-check.sh 在会话启动时负责，
#    其实现为只读+安全（见该文件注释）。此处不再重复，避免双重误报。
#
# 2. **危险的操作建议（原第 22~25 行）**
#    原文案建议用户执行 `git checkout .` 来"获取最新代码" —— 这条命令
#    **会不可恢复地丢弃所有已跟踪文件的未提交改动**（已用沙箱实验证实）。
#    本 hook 中已彻底移除该建议。
# ──────────────────────────────────────────────────────────────────────────────

# ======== JS 语法检查（前置拦截） ========
# 只检查本次暂存的 .js 文件，避免全库扫描的开销。
# 注意：这里刻意使用 `node --check` 而非 vm.Script —— hook 运行在高频
# 提交路径上，且需与开发者本地直觉一致；全库扫描由 npm run check:js 负责。
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' || true)
if [ -n "$STAGED_JS" ]; then
    HAS_ERROR=0
    for f in $STAGED_JS; do
        # 跳过构建产物：它是 python build.py 拼接生成的巨型单文件，
        # 对产物做语法检查无意义（源码已在上游被检查过）。
        if [ "$f" = "dist/app.js" ]; then continue; fi
        if [ -f "$f" ]; then
            if ! node --check "$f" 2>/dev/null; then
                echo ""
                echo "=============================================="
                echo "  ❌ JS 语法错误：$f"
                echo "=============================================="
                node --check "$f" 2>&1 | head -5
                HAS_ERROR=1
            fi
        fi
    done
    if [ "$HAS_ERROR" -ne 0 ]; then
        echo ""
        echo "请在提交前修复以上语法错误。可运行:"
        echo "  node --check <文件名>"
        echo "来定位具体错误。"
        echo "=============================================="
        exit 1
    fi
fi

# ======== src/ 变更 → dist/ 新鲜度检查 ========
# 如果暂存的改动包含 src/ 下的文件，但 dist/index.html 比 src/ 中某些文件旧，
# 说明忘记重新运行 build.py，阻止提交并提示。
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/' | head -1 || true)
DIST_FILE="dist/index.html"
if [ -n "$STAGED_SRC" ] && [ -f "$DIST_FILE" ]; then
    # 找到暂存区中最新 src/ 文件的 mtime
    NEWER_SRC=""
    for f in $STAGED_SRC; do
        if [ -f "$f" ] && [ "$f" -nt "$DIST_FILE" ]; then
            NEWER_SRC="$f"
            break
        fi
    done
    if [ -n "$NEWER_SRC" ]; then
        echo ""
        echo "=============================================="
        echo "  ⚠️  dist/index.html 已过期！"
        echo "=============================================="
        echo ""
        echo "检测到 src/ 下有文件比 dist/index.html 更新:"
        echo "  - $NEWER_SRC"
        echo ""
        echo "请先重新构建:  npm run build:legacy   （= python build.py）"
        echo "然后重新 add + commit。"
        echo ""
        echo "如果确定要跳过（如纯文档改动），加 --no-verify:"
        echo "  git commit --no-verify"
        echo "=============================================="
        exit 1
    fi
fi

# 说明：本 hook 不写 .claude/last_known_head。
# pre-commit 阶段 HEAD 尚未前进，写入会用旧值覆盖；该记录由 post-commit
# 在提交成功后更新（见 .githooks/post-commit）。
exit 0
