    │   ├── needs.js    # 需求系统
    │   ├── pricing.js  # 定价系统
    │   ├── trade.js    # 交易系统
    │   └── weather.js  # 天气系统
    ├── phase2/         # 公司阶段逻辑
    │   ├── corp_ops.js # 公司运营
    │   ├── investment.js  # 投资系统
