  /* ====== Tab 栏 ====== */
  #tab-bar { padding: 0 8px; }
  .tab-btn { min-width: 76px; padding: 10px 12px; font-size: 13px; }

  /* ====== 内容区 ====== */
  #content-area { padding: 10px; padding-bottom: 16px; }
  #time-slot-indicator {
    align-items: flex-start;
    padding: 10px 12px;
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  /* ====== 行动卡片 ====== */
  .action-cards { grid-template-columns: 1fr !important; gap: 9px; }
  .action-card { min-height: 92px; padding: 10px; }
  .action-card .card-icon { min-height: 24px; font-size: 20px; }
  .card-meta { gap: 8px; flex-wrap: wrap; }

  /* ====== 背包 ====== */
  .inventory-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .inventory-item { min-height: 82px; padding: 8px 6px; font-size: 12px; }
  .inventory-item .item-name,
  .inventory-item .item-effects { overflow-wrap: anywhere; }

  /* ====== 地图 ====== */
  .city-map { min-height: 330px !important; padding: 10px !important; }
  .city-map > div { min-width: 560px !important; min-height: 330px !important; }
  .city-map .map-node,
  .map-node { min-width: 78px !important; padding: 8px 9px !important; }

  /* ====== 弹窗 & 百科 ====== */
  .modal-box h2 { font-size: 18px; line-height: 1.35; }
  .modal-box p,
  .wiki-detail-body p,
  .wiki-detail-body ul,
  .wiki-detail-body ol { font-size: 13px; }
  .wiki-nav-btn { min-width: 70px; padding: 8px; }
  .wiki-content { padding: 12px; }
  .wiki-entries { grid-template-columns: 1fr; }

  /* ====== 欢迎/选模式 ====== */
  .welcome-screen { padding: 22px 14px; gap: 12px; }
  #sandbox-screen { padding-top: 14px; }
  .welcome-subtitle { font-size: 15px; max-width: 92vw; }
  .mode-grid { grid-template-columns: 1fr; }
  .mode-card {
    min-height: 112px;
    display: grid;
    grid-template-columns: 46px 1fr;
    column-gap: 10px;
    text-align: left;
    align-items: center;
  }
  .mode-card-icon { grid-row: span 3; margin-bottom: 0; font-size: 32px; text-align: center; }
  .mode-card-title,
  .mode-card-brief,
  .mode-card-diff { margin: 0; }
  .scenario-card { min-height: 92px; padding: 12px; }

  /* ====== 胜利路线 ====== */
  .victory-paths { gap: 6px 8px; line-height: 1.9; }
  .victory-path:not(:last-child)::after { margin-left: 8px; }

  /* ====== 投资 ====== */
  .investment-summary-card { flex: 1 1 calc(50% - 6px) !important; min-width: 0 !important; }
  .investment-holding-panel { -webkit-overflow-scrolling: touch; }
  .investment-holding-head { align-items: flex-start; gap: 6px; }
  .investment-holding-head span { text-align: right; }

  /* ====== 消息日志 ====== */
  #message-log { max-height: none; overflow: visible; }
  #message-log-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
  }
  #message-log.collapsed .log-content { display: none; }
  #message-log.collapsed #message-log-preview {
    display: block;
    background: var(--bg-input, #fff);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    padding: 6px 10px;
    margin: 4px 0 0;
    cursor: pointer;
    transition: background 0.15s;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  #message-log.collapsed #message-log-preview:active { background: var(--bg-hover, rgba(0, 0, 0, 0.04)); }
  #message-log:not(.collapsed) #message-log-preview { display: none; }
  #message-log .log-content {
    max-height: min(42vh, 320px) !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
  }

  /* 投资持仓行移动端溢出防护 */
  .investment-holdings-row {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .investment-holdings-row > div {
    min-width: 480px;
  }
  .inv-holdings-mobile-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    padding: 6px 0;
    font-size: 11px;
    align-items: center;
  }
  .inv-holdings-mobile-row > span {
    flex: 0 1 auto;
    min-width: 0;
  }
  .life-system-actions {
    width: 100%;
    justify-content: stretch !important;
  }
  .life-system-actions .btn {
    flex: 1 1 120px;
    min-height: 44px;
  }

