/* ================================================================
   城市浮生记 (City Life Story) — 全局样式
   设计参考: Notion Light + Kindle Green Mode + Zen Garden
   主题: 鲜亮绿色护眼 — 奶油白底色 + 鼠尾草绿强调，减少暗沉，长时间游玩不疲劳
   文字配色参考（眼舒适度权威研究）:
   - Material Design 3 — on-surface 色阶系统 (1C1B1F → 49454F)
   - Solarized — 柔和暖灰调，16色调色板减少视网膜疲劳
   - iA Writer / Bear — 专业写作工具的低刺激文字色
   - WCAG 2.1 AA — 正文 ≥4.5:1、大文字 ≥3:1 对比度（在 #f5f1e8 背景上精确校准）
   - GitHub Primer / Linear / Notion — 现代 SaaS 的阅读舒适配色
   ================================================================ */

/* ====== CSS 变量 / 主题 (鲜亮绿色护眼 + 柔和文字) ====== */
:root {
  --bg-primary: #f5f1e8;
  --bg-secondary: #faf7f0;
  --bg-card: #ffffff;
  --bg-card-hover: #f0f7f0;
  --bg-sidebar: #faf7f0;
  --bg-input: #f0ede4;

  --border: #d8d5c8;
  --border-light: #c5d5c0;

  /* 文字颜色 — 在奶油白 (#f5f1e8) 背景上精确校准:
     --text-primary:   ~7.2:1 对比度（正文阅读最优，柔和但不疲劳）
     --text-secondary: ~4.8:1 对比度（次级信息，减轻视觉重量）
     --text-muted:     ~3.2:1 对比度（辅助/提示文字，低视觉优先级）
     色调选择暖灰而非冷黑 — 暖色调减少蓝光刺激，长时间阅读更舒适 */
  --text-primary: #3d3a35;
  --text-secondary: #6b6760;
  --text-muted: #99958e;

  --accent: #4a9e5c;
  --accent-glow: rgba(74, 158, 92, 0.12);
  --accent-hover: #3a8048;

  --success: #4a9e5c;
  --success-bg: rgba(74, 158, 92, 0.1);
  --danger: #c4553d;
  --danger-bg: rgba(196, 85, 61, 0.08);
  --warning: #c49a3a;
  --warning-bg: rgba(196, 154, 58, 0.1);
  --info: #5a8ab4;

  /* 属性条颜色 — 降低饱和度，柔和不刺眼 */
  --hair-color: #7ab8d8;
  --mental-color: #b8a0d4;
  --kpi-color: #d4a840;
  --risk-color: #c4553d;
  --physique-color: #c4803a;
  --intelligence-color: #5a8ab4;
  --agility-color: #5aaa5a;
  --mental-attrs-color: #9b74b8;

  --font-mono: "Consolas", "Courier New", monospace;
  --font-sans:
    -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Microsoft YaHei", sans-serif;

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;

  --sidebar-width: 280px;
  --header-height: 48px;
  --transition: 0.2s ease;
}

/* ====== Reset ====== */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  height: 100%;
  overflow: hidden;
}

body {
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-primary);
  background: var(--bg-primary);
  -webkit-font-smoothing: antialiased;
}

/* ====== Scrollbar ====== */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--border-light);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

/* ====== App Layout (CSS Grid) ====== */
#app {
  display: grid;
  grid-template-rows: var(--header-height) 1fr;
  grid-template-columns: var(--sidebar-width) 1fr;
  grid-template-areas:
    "header header"
    "sidebar main";
  height: 100vh;
  max-height: 100vh;
}

/* ====== Header ====== */
#header {
  grid-area: header;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-logo {
  font-size: 18px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.5px;
}

.header-logo span {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 400;
  margin-left: 6px;
}

.header-stats {
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 13px;
}

.header-stat {
  display: flex;
  align-items: center;
  gap: 6px;
}

.header-stat .label {
  color: var(--text-muted);
  font-size: 11px;
}

.header-stat .value {
  color: var(--text-primary);
  font-weight: 600;
}

.header-stat .value.cash {
  color: var(--success);
}

.header-stat .value.debt {
  color: var(--danger);
  font-weight: 700;
}

.header-context {
  gap: 4px;
  max-width: min(44vw, 560px);
  overflow-x: auto;
  padding-bottom: 2px;
}

.header-context .context-chip {
  flex: 0 0 auto;
  padding: 2px 6px;
  border-radius: 5px;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 11px;
  white-space: nowrap;
}

/* 单债务闪烁（只有一种债务时，沉稳的红色呼吸闪烁） */
.header-stat .value.debt.single-debt-blink {
  animation: debt-blink 1.2s ease-in-out infinite;
}

/* 多债务轮播项的闪烁（轮播到当前项时闪烁） */
.header-stat .value.debt.carousel-debt-blink {
  animation: debt-blink 0.9s ease-in-out infinite;
}

/* 债务区域背景闪烁（有债务时整块区域有微弱红光提醒） */
.header-debt-active {
  border: 1px solid rgba(196, 85, 61, 0.25) !important;
  border-radius: 6px !important;
  padding: 0 8px !important;
  background: rgba(196, 85, 61, 0.06) !important;
  animation: debt-pulse-bg 2s ease-in-out infinite;
}

/* 多债务轮播时，整个区域呼吸式脉冲呼吸 */
.header-debt-carousel-active {
  border: 1px solid rgba(196, 85, 61, 0.3) !important;
  border-radius: 6px !important;
  padding: 0 8px !important;
  background: rgba(196, 85, 61, 0.1) !important;
  animation: debt-carousel-pulse 2.5s ease-in-out infinite;
}

@keyframes debt-blink {
  0%,
  100% {
    opacity: 1;
    text-shadow: 0 0 0 transparent;
  }
  50% {
    opacity: 0.55;
    text-shadow: 0 0 6px rgba(196, 85, 61, 0.4);
  }
}

@keyframes debt-pulse-bg {
  0%,
  100% {
    background: rgba(196, 85, 61, 0.06);
  }
  50% {
    background: rgba(196, 85, 61, 0.14);
  }
}

@keyframes debt-carousel-pulse {
  0%,
  100% {
    background: rgba(196, 85, 61, 0.1);
    border-color: rgba(196, 85, 61, 0.3);
  }
  50% {
    background: rgba(196, 85, 61, 0.18);
    border-color: rgba(196, 85, 61, 0.5);
  }
}

/* 债务轮播标签切换（旧标签淡出，新标签淡入） */
@keyframes debt-fade-in {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.debt-fade-in {
  animation: debt-fade-in 0.35s ease-out;
}

.header-stat .value.age {
  color: var(--warning);
}

.festival-badge {
  color: #c4553d;
  font-weight: 700;
  font-size: 12px;
  background: rgba(196, 85, 61, 0.08);
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid rgba(196, 85, 61, 0.2);
  animation: festival-pulse 2s ease-in-out infinite;
}

@keyframes festival-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ====== Sidebar ====== */
#sidebar {
  grid-area: sidebar;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.sidebar-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 12px;
  border: 1px solid transparent;
}

.sidebar-section h3 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  margin-bottom: 10px;
  font-weight: 600;
}

/* --- 属性条 --- */
.stat-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.stat-label {
  width: 65px;
  font-size: 12px;
  color: var(--text-secondary);
  text-align: right;
  flex-shrink: 0;
}

.stat-bar-wrap {
  flex: 1;
  height: 16px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
}

.stat-bar {
  height: 100%;
  border-radius: var(--radius-sm);
  transition: width 0.4s ease;
  position: relative;
}

/* 数值变化闪烁动画 */
.stat-bar.flash {
  animation: statFlash 0.6s ease;
}

@keyframes statFlash {
  0% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(2.5);
  }
  100% {
    filter: brightness(1);
  }
}

.stat-bar.hair {
  background: linear-gradient(90deg, #6b9cbe, var(--hair-color));
}
.stat-bar.dignity {
  background: linear-gradient(90deg, #a48aca, var(--mental-color));
}
.stat-bar.kpi {
  background: linear-gradient(90deg, #c9a442, var(--kpi-color));
}
.stat-bar.risk {
  background: linear-gradient(90deg, #c87062, var(--risk-color));
}
.stat-bar.physique {
  background: linear-gradient(90deg, #c48e4a, var(--physique-color));
}
.stat-bar.intelligence {
  background: linear-gradient(90deg, #5a94ba, var(--intelligence-color));
}
.stat-bar.agility {
  background: linear-gradient(90deg, #56a64e, var(--agility-color));
}
.stat-bar.mental-bar {
  background: linear-gradient(90deg, #9672b4, var(--mental-attrs-color));
}
.stat-bar.charm {
  background: linear-gradient(90deg, #d9789e, #b95f87);
}
.stat-bar.hunger {
  background: linear-gradient(90deg, #c9a838, #dec054);
}
.stat-bar.fatigue {
  background: linear-gradient(90deg, #949a88, #b4baa2);
}
.stat-bar.hygiene {
  background: linear-gradient(90deg, #4a9490, #5ebeb2);
}
.stat-bar.happiness {
  background: linear-gradient(90deg, #cc7868, #e09080);
}
.stat-bar.health {
  background: linear-gradient(90deg, #d47058, #56b468);
}
.stat-bar.fame {
  background: linear-gradient(90deg, #9672b4, #c9a442);
}
.stat-bar.ap-bar {
  background: linear-gradient(90deg, #56a868, #62b868, #50b058);
}

.stat-value {
  width: 48px;
  font-size: 11px;
  color: var(--text-muted);
  text-align: right;
  flex-shrink: 0;
  font-family: var(--font-mono);
}

/* --- 地点 --- */
.location-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.location-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--accent);
}

.location-desc {
  font-size: 11px;
  color: var(--text-muted);
}

/* ====== Main Content ====== */
#main {
  grid-area: main;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-primary);
}

/* --- Tab Bar --- */
#tab-bar {
  display: flex;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  padding: 0 12px;
  flex-shrink: 0;
}

.tab-btn {
  padding: 10px 20px;
  font-size: 13px;
  color: var(--text-muted);
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  transition: all var(--transition);
  font-family: var(--font-sans);
}

.tab-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.03);
}

.tab-btn.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* --- Content Area --- */
#content-area {
  flex: 1;
  overflow-y: auto;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* --- Time Slot Indicator --- */
#time-slot-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  font-size: 13px;
  flex-shrink: 0;
}

.time-slot-badge {
  padding: 2px 10px;
  border-radius: var(--radius-sm);
  font-size: 11px;
  font-weight: 600;
}

.time-slot-badge.morning {
  background: rgba(243, 156, 18, 0.2);
  color: var(--warning);
}
.time-slot-badge.afternoon {
  background: rgba(74, 158, 92, 0.2);
  color: var(--warning);
}
.time-slot-badge.evening {
  background: rgba(155, 116, 184, 0.2);
  color: #9b74b8;
}

/* --- Action Category Headers --- */
.action-category-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 10px;
  margin: 14px 0 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}
.action-category-header .cat-count {
  font-size: 10px;
  font-weight: 400;
  color: var(--text-muted);
  margin-left: auto;
  background: rgba(128, 128, 128, 0.08);
  padding: 1px 7px;
  border-radius: 8px;
}

/* --- Action Cards Grid --- */
.action-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 10px;
}

.action-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px;
  cursor: pointer;
  transition: all var(--transition);
  display: flex;
  flex-direction: column;
}

.action-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--accent);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px var(--accent-glow);
}

.action-card.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.action-card.disabled:hover {
  border-color: var(--border);
  transform: none;
  box-shadow: none;
}

.action-card .card-icon {
  font-size: 22px;
  margin-bottom: 4px;
  line-height: 1.2;
  display: flex;
  align-items: center;
  min-height: 26px;
}

.action-card .card-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 3px;
  line-height: 1.3;
}

.action-card .card-desc {
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 8px;
  line-height: 1.4;
}

.action-card .card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
}

.card-meta .ap-cost {
  color: var(--warning);
  font-weight: 600;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 3px;
  background: rgba(243, 156, 18, 0.12);
  border: 1px solid rgba(243, 156, 18, 0.25);
}

.card-meta .pay-estimate {
  color: var(--success);
  font-weight: 600;
}

.card-meta .cost-estimate {
  color: var(--danger);
  font-weight: 600;
}

.card-meta .slot-tag {
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  font-size: 10px;
  background: var(--accent-glow);
  color: var(--accent);
}

.card-meta .req-fail {
  color: var(--danger);
  font-size: 10px;
}

/* --- Price Preview (trade action card) --- */
.action-card .price-preview {
  font-size: 10px;
  color: var(--accent);
  margin-top: 4px;
  padding: 3px 6px;
  background: rgba(0, 180, 216, 0.06);
  border-radius: 3px;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* --- New Action Badge --- */
.badge-new {
  display: inline-block;
  font-size: 9px;
  font-weight: 700;
  color: #d4a017;
  background: rgba(255, 215, 0, 0.12);
  padding: 1px 5px;
  border-radius: 3px;
  margin-left: 4px;
  vertical-align: middle;
  animation: badge-new-pulse 2s ease-in-out infinite;
}

@keyframes badge-new-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 装备品质系统 */
.quality-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
}
.quality-common {
  background: rgba(153, 153, 153, 0.12);
  color: #888;
  border: 1px solid rgba(153, 153, 153, 0.3);
}
.quality-rare {
  background: rgba(74, 144, 217, 0.12);
  color: #5dade2;
  border: 1px solid rgba(74, 144, 217, 0.3);
}
.quality-epic {
  background: rgba(155, 89, 182, 0.12);
  color: #af7ac5;
  border: 1px solid rgba(155, 89, 182, 0.3);
}
.quality-legendary {
  background: rgba(230, 126, 34, 0.12);
  color: #f39c12;
  border: 1px solid rgba(230, 126, 34, 0.4);
  box-shadow: 0 0 8px rgba(230, 126, 34, 0.2);
}
@keyframes quality-legendary-pulse {
  0%,
  100% {
    box-shadow: 0 0 8px rgba(230, 126, 34, 0.2);
  }
  50% {
    box-shadow: 0 0 16px rgba(230, 126, 34, 0.4);
  }
}
.quality-legendary.pulse {
  animation: quality-legendary-pulse 2s ease-in-out infinite;
}
.equipment-card.quality-common {
  border-left: 3px solid #888;
}
.equipment-card.quality-rare {
  border-left: 3px solid #5dade2;
}
.equipment-card.quality-epic {
  border-left: 3px solid #af7ac5;
}
.equipment-card.quality-legendary {
  border-left: 3px solid #f39c12;
}
.quality-price {
  font-size: 12px;
  color: var(--text-secondary);
}

/* --- Message Log --- */
#message-log {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 8px 12px;
  max-height: 150px;
  overflow-y: auto;
  flex-shrink: 0;
}

#message-log h3 {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
  margin-bottom: 4px;
  font-weight: 600;
}

.log-entry {
  padding: 3px 0;
  font-size: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  animation: fadeIn 0.3s ease;
}

.log-entry .log-day {
  color: var(--text-muted);
  font-size: 10px;
  margin-right: 8px;
  font-family: var(--font-mono);
}

.log-entry.info {
  color: var(--text-secondary);
}
.log-entry.success {
  color: var(--success);
}
.log-entry.danger {
  color: var(--danger);
}
.log-entry.warning {
  color: var(--warning);
}
.log-entry.event {
  color: var(--accent);
  font-weight: 600;
}
.log-entry.hint {
  color: #27ae60;
  background: rgba(39, 174, 96, 0.06);
  border-left: 2px solid rgba(39, 174, 96, 0.35);
  padding-left: 6px;
  border-radius: 0 3px 3px 0;
}

/* --- Inventory Grid --- */
.inventory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 8px;
}

.inventory-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px;
  font-size: 12px;
}

.inventory-item .item-name {
  font-weight: 600;
  color: var(--text-primary);
}

.inventory-item .item-qty {
  color: var(--text-muted);
  font-size: 10px;
}

.inventory-item .item-effects {
  color: var(--success);
  font-size: 10px;
}

/* ====== Buttons ====== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 16px;
  font-size: 13px;
  font-family: var(--font-sans);
  font-weight: 500;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition);
  background: var(--bg-card);
  color: var(--text-primary);
  white-space: nowrap;
}

.btn:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-light);
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.btn-primary:hover {
  background: var(--accent-hover);
}

.btn-success {
  background: var(--success);
  border-color: var(--success);
  color: #fff;
}

.btn-danger {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}

.btn-sm {
  padding: 4px 10px;
  font-size: 11px;
}

.btn-lg {
  padding: 12px 24px;
  font-size: 15px;
  border-radius: var(--radius-md);
}

/* ====== 自定义数量输入控件 ====== */
.qty-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  padding: 0;
  font-size: 12px;
  line-height: 1;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  opacity: 0.5;
  transition: all var(--transition);
  flex-shrink: 0;
}
.qty-toggle-btn:hover {
  opacity: 1;
  color: var(--text-primary);
  border-color: var(--accent);
}

.qty-input-group {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 2px 4px;
  background: var(--bg-input, #f0ede4);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  animation: fadeIn 0.15s ease;
}

.qty-step-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  padding: 0;
  font-size: 12px;
  font-weight: 600;
  line-height: 1;
  border: 1px solid var(--border);
  border-radius: 3px;
  background: var(--bg-card);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.1s;
  user-select: none;
  flex-shrink: 0;
}
.qty-step-btn:hover {
  background: var(--accent-glow);
  color: var(--accent);
  border-color: var(--accent);
}
.qty-step-btn:active {
  transform: scale(0.92);
}

.qty-num-input {
  width: 44px;
  height: 20px;
  padding: 0 4px;
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 3px;
  background: var(--bg-card);
  color: var(--text-primary);
  outline: none;
  transition: border-color var(--transition);
  -moz-appearance: textfield;
  flex-shrink: 0;
}
.qty-num-input::-webkit-outer-spin-button,
.qty-num-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
.qty-num-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-glow);
}

/* ====== Modal ====== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  min-width: 360px;
  width: min(520px, calc(100vw - 28px));
  max-width: calc(100vw - 28px);
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  animation: slideUp 0.2s ease;
}

.modal-box h2 {
  font-size: 18px;
  margin-bottom: 12px;
  color: var(--text-primary);
}

.modal-box p {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 16px;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.modal-actions .btn {
  max-width: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.35;
}

.modal-actions .btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.critical-choice-box {
  max-width: 560px;
}

.critical-choice-actions {
  flex-direction: column;
  align-items: stretch;
}

.critical-choice-actions .critical-choice-btn {
  width: 100%;
  min-height: 42px;
  padding: 9px 12px;
  text-align: left;
  justify-content: flex-start;
}

/* ====== Inheritance Summary Modal ====== */
.inheritance-summary {
  max-width: 500px;
}

.inheritance-summary .badge-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 8px 12px;
  margin-bottom: 6px;
  font-size: 13px;
}

.inheritance-summary .badge-icon {
  font-size: 20px;
  margin-right: 8px;
}

.inheritance-summary .cash-highlight {
  color: #4caf50;
  font-weight: bold;
}

.inheritance-summary .narrative-text {
  margin: 12px 0;
  padding: 10px 12px;
  background: linear-gradient(
    135deg,
    rgba(76, 175, 80, 0.1),
    rgba(33, 150, 243, 0.1)
  );
  border-radius: 6px;
  border-left: 3px solid #4caf50;
  font-size: 13px;
  font-style: italic;
}

/* ====== Daily Report Modal ====== */
.daily-report-box {
  max-width: 460px;
  min-width: 380px;
  padding: 20px 22px;
}

.daily-report-box .btn-lg {
  font-size: 15px;
  padding: 10px 24px;
  min-width: 180px;
}

/* 条目行 */
.daily-report-item {
  display: flex;
  align-items: center;
  padding: 3px 0;
  font-size: 13px;
  border-bottom: 1px solid rgba(216, 213, 200, 0.3);
}

.daily-report-item:last-child {
  border-bottom: none;
}

.daily-report-item-icon {
  width: 20px;
  text-align: center;
  flex-shrink: 0;
}

.daily-report-item-cat {
  font-size: 10px;
  color: var(--text-muted);
  min-width: 32px;
  text-align: center;
  flex-shrink: 0;
  background: var(--bg-card);
  padding: 1px 4px;
  border-radius: 3px;
  margin: 0 6px;
}

.daily-report-item-desc {
  flex: 1;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
}

.daily-report-item-amount {
  font-weight: 700;
  white-space: nowrap;
  text-align: right;
  min-width: 70px;
}

/* 抖动动画（点击背景无效时提示） */
@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-6px);
  }
  40% {
    transform: translateX(6px);
  }
  60% {
    transform: translateX(-4px);
  }
  80% {
    transform: translateX(4px);
  }
}

/* ====== Game Over / Victory Screen ====== */
.end-screen {
  text-align: center;
}

.end-screen .end-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.end-screen .end-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 8px;
}

.end-screen .end-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 20px;
}

.end-screen.victory .end-title {
  color: var(--success);
}
.end-screen.defeat .end-title {
  color: var(--danger);
}

/* --- Stats Summary Table --- */
.stats-summary {
  width: 100%;
  border-collapse: collapse;
  margin: 16px 0;
}

.stats-summary td {
  padding: 6px 12px;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
}

.stats-summary td:first-child {
  color: var(--text-muted);
}

.stats-summary td:last-child {
  text-align: right;
  font-weight: 600;
}

/* ====== News Banner ====== */
.news-banner {
  background: linear-gradient(135deg, var(--bg-card), rgba(74, 158, 92, 0.08));
  border: 1px solid var(--accent);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: 12px;
  color: var(--accent);
  flex-shrink: 0;
}

.news-banner .news-icon {
  margin-right: 6px;
}

/* ====== Event Modal (Random Story Event) ====== */
.event-box {
  min-width: 380px;
  max-width: 540px;
  border-top: 4px solid var(--accent);
  background: linear-gradient(180deg, var(--bg-secondary), var(--bg-card));
}

.event-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.event-icon {
  font-size: 40px;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, rgba(74, 158, 92, 0.15), transparent);
  border-radius: 50%;
  flex-shrink: 0;
}

.event-title {
  font-size: 18px;
  color: var(--accent);
  margin: 0;
}

.event-story {
  font-size: 13px;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 16px;
  padding: 12px 14px;
  background: var(--bg-card);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
}

.event-choices {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.event-choice {
  display: block;
  width: 100%;
  text-align: left;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  color: var(--text-primary);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.15s ease;
  position: relative;
}

.event-choice:hover:not(.disabled) {
  background: var(--bg-card-hover, rgba(74, 158, 92, 0.08));
  border-color: var(--accent);
  transform: translateX(2px);
}

.event-choice.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.event-choice .choice-main {
  font-weight: 600;
  color: var(--text-primary);
}

.event-choice .choice-hint {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 3px;
}

/* 弹窗进入动画 */
@keyframes eventPop {
  0% {
    transform: scale(0.85) translateY(-20px);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.event-overlay,
.modal-overlay.event-modal {
  animation: fadeIn 0.2s ease;
}

.event-overlay .modal-box,
.modal-overlay.event-modal .modal-box {
  animation: eventPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ====== Utility Classes ====== */
.text-success {
  color: var(--success);
}
.text-danger {
  color: var(--danger);
}
.text-warning {
  color: var(--warning);
}
.text-accent {
  color: var(--accent);
}
.text-muted {
  color: var(--text-muted);
}
.text-sm {
  font-size: 11px;
}
.text-lg {
  font-size: 16px;
}
.font-mono {
  font-family: var(--font-mono);
}

.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.items-center {
  align-items: center;
}
.justify-between {
  justify-content: space-between;
}
.gap-2 {
  gap: 8px;
}
.gap-4 {
  gap: 16px;
}
.mt-2 {
  margin-top: 8px;
}
.mt-4 {
  margin-top: 16px;
}
.mb-2 {
  margin-bottom: 8px;
}

/* ====== Animations ====== */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.pulse {
  animation: pulse 2s infinite;
}

/* ====== Welcome Screen ====== */
.welcome-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  gap: 24px;
  text-align: center;
}

.welcome-title {
  font-size: 36px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 1px;
}

.welcome-subtitle {
  font-size: 14px;
  color: var(--text-muted);
  max-width: 400px;
  line-height: 1.6;
}

.welcome-buttons {
  display: flex;
  gap: 12px;
}

/* ====== Tab Content Panels ====== */
.tab-panel {
  display: none;
}

.tab-panel.active {
  display: block;
}

/* ====== City Map ====== */
.city-map {
  position: relative;
}

.city-map .map-node {
  animation: mapFadeIn 0.4s ease backwards;
}

.city-map .map-node:nth-child(1) {
  animation-delay: 0.02s;
}
.city-map .map-node:nth-child(2) {
  animation-delay: 0.04s;
}
.city-map .map-node:nth-child(3) {
  animation-delay: 0.06s;
}
.city-map .map-node:nth-child(4) {
  animation-delay: 0.08s;
}
.city-map .map-node:nth-child(5) {
  animation-delay: 0.1s;
}
.city-map .map-node:nth-child(6) {
  animation-delay: 0.12s;
}
.city-map .map-node:nth-child(7) {
  animation-delay: 0.14s;
}
.city-map .map-node:nth-child(8) {
  animation-delay: 0.16s;
}
.city-map .map-node:nth-child(9) {
  animation-delay: 0.18s;
}
.city-map .map-node:nth-child(10) {
  animation-delay: 0.2s;
}
.city-map .map-node:nth-child(11) {
  animation-delay: 0.22s;
}

@keyframes mapFadeIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* Nearby locations sidebar widget */
.nearby-loc-item {
  cursor: pointer;
  transition: all 0.2s ease;
}

.nearby-loc-item:hover {
  border-color: var(--accent) !important;
  background: var(--bg-card-hover) !important;
  transform: translateX(2px);
}

/* Location services badges area */
#location-services {
  min-height: 20px;
}

#mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  color: var(--text-primary);
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
}

@media (min-width: 769px) {
  #mobile-menu-btn {
    display: none !important;
  }
}

/* ====== Tutorial System ====== */
.tutorial-overlay .modal-box {
  border: 2px solid var(--accent);
  box-shadow: 0 0 40px rgba(102, 126, 234, 0.3);
}
.tutorial-box {
  animation: fadeInUp 0.3s ease-out;
}
@keyframes tutorial-pulse {
  0%,
  100% {
    box-shadow:
      0 0 25px rgba(102, 126, 234, 0.5),
      inset 0 0 25px rgba(102, 126, 234, 0.08);
  }
  50% {
    box-shadow:
      0 0 40px rgba(102, 126, 234, 0.8),
      inset 0 0 40px rgba(102, 126, 234, 0.15);
  }
}
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ====== 存档对比系统 ====== */
.compare-container {
  max-width: 600px;
  margin: 0 auto;
}
.compare-header {
  display: flex;
  justify-content: space-around;
  padding: 10px;
  background: var(--bg-card);
  border-radius: 6px;
  margin-bottom: 12px;
}
.compare-header .compare-col {
  text-align: center;
}
.compare-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  border-bottom: 1px solid var(--border-light);
  font-size: 13px;
}
.compare-row:last-child {
  border-bottom: none;
}
.compare-label {
  color: var(--text-secondary);
  font-weight: 500;
}
.compare-same {
  color: var(--text-primary);
  font-weight: 600;
}
.compare-val {
  font-weight: 600;
}
.compare-val.old {
  color: var(--text-muted);
}
.compare-val.new {
  min-width: 80px;
  text-align: center;
}
.compare-gain {
  color: var(--success) !important;
}
.compare-loss {
  color: var(--danger) !important;
}
.compare-arrow {
  color: var(--text-muted);
  font-size: 12px;
  width: 20px;
  text-align: center;
}
.compare-diff {
  font-size: 11px;
  margin-left: 8px;
}

/* 低行动力闪烁警告 */
@keyframes ap-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}
@keyframes ap-blink-border {
  0%,
  100% {
    box-shadow: 0 0 12px rgba(255, 152, 0, 0.4);
  }
  50% {
    box-shadow: 0 0 24px rgba(255, 152, 0, 0.8);
  }
}

/* ====== 📖 百科 Wiki Tab ====== */
.wiki-tab {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.wiki-header h2 {
  font-size: 18px;
  color: var(--accent);
}
.wiki-search {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}
.wiki-search input {
  flex: 1;
  padding: 8px 12px;
  border: 1px solid #d8d3c5;
  border-radius: 8px;
  background: #fff;
  color: var(--text-primary);
  font-size: 13px;
  font-family: var(--font-sans);
}
.wiki-search input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(74, 158, 92, 0.2);
}
.wiki-clear {
  padding: 8px 12px;
  background: #fff;
  border: 1px solid #d8d3c5;
  border-radius: 8px;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 12px;
}
.wiki-clear:hover {
  border-color: var(--danger);
  color: var(--danger);
}

.wiki-layout {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 16px;
  align-items: start;
}
.wiki-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: #ffffff;
  border: 1px solid #e6e0d0;
  border-radius: 10px;
  padding: 8px;
  position: sticky;
  top: 0;
}
.wiki-nav-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 12px;
  text-align: left;
  transition: all 0.15s;
  font-family: var(--font-sans);
}
.wiki-nav-btn:hover {
  background: #f5f1e8;
  color: var(--text-primary);
}
.wiki-nav-btn.active {
  background: rgba(74, 158, 92, 0.12);
  color: var(--accent);
  font-weight: 600;
}
.wiki-nav-ico {
  font-size: 14px;
  width: 18px;
  text-align: center;
}
.wiki-nav-name {
  flex: 1;
}
.wiki-nav-count {
  font-size: 10px;
  color: var(--text-muted);
  background: #f5f1e8;
  border-radius: 8px;
  padding: 1px 6px;
  min-width: 22px;
  text-align: center;
}
.wiki-nav-btn.active .wiki-nav-count {
  background: rgba(74, 158, 92, 0.2);
  color: var(--accent);
}

.wiki-content {
  background: #ffffff;
  border: 1px solid #e6e0d0;
  border-radius: 10px;
  padding: 16px;
  min-height: 300px;
}
.wiki-list-header h3 {
  margin: 0 0 12px;
  font-size: 16px;
  color: var(--text-primary);
}
.wiki-count {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: normal;
}
.wiki-empty {
  color: var(--text-muted);
  text-align: center;
  padding: 40px;
}
.wiki-entries {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px;
}
.wiki-card {
  background: #fdfaf3;
  border: 1px solid #e6e0d0;
  border-radius: 8px;
  padding: 10px 12px;
  cursor: pointer;
  transition: all 0.15s;
}
.wiki-card:hover {
  border-color: var(--accent);
  background: #fff;
  transform: translateY(-1px);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}
.wiki-card-head {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
}
.wiki-card-head h4 {
  margin: 0;
  font-size: 13px;
  color: var(--text-primary);
  flex: 1;
}
.wiki-card-ico {
  font-size: 16px;
}
.wiki-card-brief {
  margin: 0;
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.wiki-badge {
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 6px;
  font-weight: 600;
  white-space: nowrap;
}
.wiki-badge.ok {
  background: rgba(74, 158, 92, 0.15);
  color: var(--accent);
}
.wiki-badge.warn {
  background: rgba(212, 160, 23, 0.15);
  color: #b08712;
}
.wiki-badge.info {
  background: rgba(52, 152, 219, 0.15);
  color: #2575b3;
}
.wiki-badge.bad {
  background: rgba(231, 76, 60, 0.15);
  color: var(--danger);
}
.wiki-badge.muted {
  background: #f0ebde;
  color: var(--text-muted);
}

/* 详情视图 */
.wiki-detail {
  position: relative;
}
.wiki-back {
  background: #f5f1e8;
  border: 1px solid #d8d3c5;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 12px;
  color: var(--text-secondary);
  cursor: pointer;
  margin-bottom: 12px;
}
.wiki-back:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.wiki-detail-body h2 {
  font-size: 18px;
  margin: 0 0 8px;
  color: var(--text-primary);
}
.wiki-detail-body h3 {
  font-size: 14px;
  margin: 16px 0 8px;
  color: var(--accent);
  border-bottom: 1px solid #ece7d8;
  padding-bottom: 4px;
}
.wiki-detail-body p,
.wiki-detail-body ul,
.wiki-detail-body ol {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.7;
}
.wiki-detail-body code {
  background: #f5f1e8;
  border-radius: 3px;
  padding: 1px 4px;
  font-family: var(--font-mono, monospace);
  font-size: 11px;
}
.wiki-desc {
  font-size: 13px !important;
  color: var(--text-secondary);
  margin: 0 0 12px;
  font-style: italic;
}
.wiki-attrs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 8px;
  background: #fdfaf3;
  border-radius: 8px;
  padding: 10px;
  margin-bottom: 12px;
}
.wiki-attrs > div {
  font-size: 12px;
  color: var(--text-secondary);
}
.wiki-attrs b {
  color: var(--text-primary);
  margin-right: 6px;
}
.wiki-list {
  margin: 0 0 12px 16px;
  padding: 0;
}
.wiki-list li {
  margin-bottom: 4px;
}
.wiki-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  margin: 8px 0 12px;
}
.wiki-table th,
.wiki-table td {
  padding: 6px 8px;
  border: 1px solid #ece7d8;
  text-align: left;
  color: var(--text-secondary);
}
.wiki-table th {
  background: #fdfaf3;
  color: var(--text-primary);
  font-weight: 600;
}
.wiki-table tr:nth-child(even) td {
  background: #fdfaf3;
}
.wiki-link {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
  border-bottom: 1px dashed rgba(74, 158, 92, 0.4);
  cursor: pointer;
}
.wiki-link:hover {
  border-bottom-style: solid;
  background: rgba(74, 158, 92, 0.06);
}
.wiki-links {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
}
.wiki-links .wiki-link {
  background: #fdfaf3;
  border: 1px solid #e6e0d0;
  border-radius: 14px;
  padding: 4px 10px;
  border-bottom: 1px solid #e6e0d0;
  font-size: 11px;
}
.wiki-links .wiki-link:hover {
  border-color: var(--accent);
  background: rgba(74, 158, 92, 0.08);
}
.wiki-tip {
  background: rgba(74, 158, 92, 0.06);
  border-left: 3px solid var(--accent);
  padding: 8px 10px;
  border-radius: 0 6px 6px 0;
  font-size: 12px !important;
  color: var(--text-secondary);
  margin: 8px 0 12px;
}
.wiki-quote {
  background: #fdfaf3;
  border-left: 3px solid #d4a017;
  padding: 8px 10px;
  border-radius: 0 6px 6px 0;
  font-size: 12px !important;
  color: var(--text-secondary);
  font-style: italic;
  margin: 8px 0;
}
.wiki-pill {
  display: inline-block;
  background: #f5f1e8;
  border: 1px solid #e6e0d0;
  border-radius: 12px;
  padding: 2px 10px;
  font-size: 11px;
  color: var(--text-secondary);
}

/* 移动端适配 */
@media (max-width: 760px) {
  .wiki-layout {
    grid-template-columns: 1fr;
  }
  .wiki-nav {
    flex-direction: row;
    overflow-x: auto;
    position: relative;
  }
  .wiki-nav-btn {
    flex: 0 0 auto;
    flex-direction: column;
    padding: 6px 8px;
    min-width: 60px;
    text-align: center;
  }
  .wiki-nav-btn .wiki-nav-name {
    font-size: 10px;
  }
  .wiki-nav-btn .wiki-nav-count {
    font-size: 9px;
    padding: 0 4px;
  }
  .wiki-entries {
    grid-template-columns: 1fr;
  }
}

/* ====== 春节事件弹窗专属样式 ====== */
.spring-fest-modal .modal-box {
  border: 2px solid rgba(231, 76, 60, 0.5);
  background: linear-gradient(
    180deg,
    rgba(196, 85, 61, 0.08),
    var(--bg-secondary)
  );
  border-top: 4px solid #e74c3c;
}

.spring-fest-modal .event-header {
  border-bottom-color: rgba(231, 76, 60, 0.3);
}

.spring-fest-modal .event-icon {
  background: radial-gradient(circle, rgba(231, 76, 60, 0.2), transparent);
}

.spring-fest-modal .event-title {
  color: #e74c3c;
}

/* 春节进度指示器 */
.spring-fest-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-bottom: 12px;
  padding: 6px 12px;
  background: rgba(231, 76, 60, 0.06);
  border-radius: 20px;
}

.spring-fest-progress-label {
  font-size: 10px;
  color: #e74c3c;
  font-weight: 600;
  letter-spacing: 1px;
}

.spring-fest-progress-dots {
  display: flex;
  gap: 4px;
}

.spring-fest-progress-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(231, 76, 60, 0.2);
  transition: all 0.3s ease;
}

.spring-fest-progress-dot.active {
  background: #e74c3c;
  box-shadow: 0 0 6px rgba(231, 76, 60, 0.6);
}

.spring-fest-progress-dot.passed {
  background: #c0392b;
}

/* 春节选项按钮增强 */
.spring-fest-modal .event-choice {
  border-color: rgba(231, 76, 60, 0.15);
}

.spring-fest-modal .event-choice:hover:not(.disabled) {
  border-color: #e74c3c;
  background: linear-gradient(
    90deg,
    rgba(231, 76, 60, 0.08),
    var(--bg-card-hover)
  );
}

.spring-fest-modal .event-choice .choice-main {
  color: #e74c3c;
}

/* 春节装饰元素 */
.spring-fest-decor {
  position: absolute;
  font-size: 14px;
  opacity: 0.15;
  pointer-events: none;
  animation: springFestFloat 3s ease-in-out infinite;
}

.spring-fest-decor.lantern-left {
  top: 10px;
  left: 10px;
}

.spring-fest-decor.lantern-right {
  top: 10px;
  right: 10px;
  animation-delay: 0.5s;
}

.spring-fest-decor.coin-bottom {
  bottom: 10px;
  right: 15px;
  animation-delay: 1s;
}

@keyframes springFestFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4px);
  }
}

/* 春节弹窗入场动画增强 */
.spring-fest-modal .modal-box {
  animation: springFestPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes springFestPop {
  0% {
    transform: scale(0.8) translateY(-30px);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* 春节事件故事文本高亮关键词 */
.spring-fest-story .highlight {
  color: #e74c3c;
  font-weight: 600;
}

/* ====== 公司历史书弹窗样式 ====== */
.company-history-modal .modal-box {
  max-width: 720px;
  min-width: 500px;
  max-height: 85vh;
  overflow-y: auto;
  border-top: 4px solid #4a9e5c;
  background: linear-gradient(
    180deg,
    rgba(74, 158, 92, 0.06),
    var(--bg-secondary)
  );
}

.company-history-modal .modal-box::-webkit-scrollbar {
  width: 6px;
}

.company-history-modal .modal-box::-webkit-scrollbar-thumb {
  background: rgba(74, 158, 92, 0.3);
  border-radius: 3px;
}

/* 头部 */
.ch-title-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ch-icon {
  font-size: 48px;
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, rgba(74, 158, 92, 0.15), transparent);
  border-radius: 12px;
}

.ch-titles {
  flex: 1;
}

.ch-name {
  font-size: 20px;
  color: var(--text-primary);
  margin: 0 0 4px 0;
}

.ch-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.ch-industry {
  font-size: 11px;
  color: var(--text-muted);
  background: var(--bg-input);
  padding: 2px 8px;
  border-radius: 10px;
}

.ch-status {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 600;
}

.ch-status.ipo {
  background: rgba(76, 175, 80, 0.15);
  color: #4caf50;
}

.ch-status.ceased {
  background: rgba(231, 76, 60, 0.15);
  color: #e74c3c;
}

.ch-close {
  background: none;
  border: none;
  font-size: 18px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 4px;
  transition: all 0.15s;
}

.ch-close:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
}

/* 通用区块 */
.ch-section {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.ch-section:first-of-type {
  margin-top: 12px;
}

.ch-section-title {
  font-size: 13px;
  color: var(--text-primary);
  margin: 0 0 10px 0;
  font-weight: 600;
}

/* 基本信息 */
.ch-basic-info {
  background: rgba(74, 158, 92, 0.04);
  border-radius: 8px;
  padding: 10px 14px;
}

.ch-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.ch-info-row:last-child {
  border-bottom: none;
}

.ch-label {
  font-size: 12px;
  color: var(--text-muted);
}

.ch-value {
  font-size: 12px;
  color: var(--text-primary);
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

.ch-bio {
  font-style: italic;
  color: var(--text-secondary);
}

/* 当前状态 */
.ch-status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.ch-stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.ch-stat-label {
  font-size: 11px;
  color: var(--text-muted);
}

.ch-stat-value {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.ch-stat-bar {
  height: 6px;
  background: var(--bg-input);
  border-radius: 3px;
  overflow: hidden;
}

.ch-stat-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a9e5c, #66bb6a);
  border-radius: 3px;
  transition: width 0.3s ease;
}

/* 时间线 */
.ch-timeline {
  position: relative;
  padding-left: 24px;
}

.ch-timeline::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(
    180deg,
    rgba(74, 158, 92, 0.3),
    rgba(74, 158, 92, 0.05)
  );
}

.ch-timeline-item {
  position: relative;
  padding: 8px 0 8px 16px;
}

.ch-timeline-dot {
  position: absolute;
  left: -22px;
  top: 6px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 2px solid rgba(74, 158, 92, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  z-index: 1;
}

/* 里程碑颜色分类 */
.ch-milestone-ipo .ch-timeline-dot {
  border-color: #4caf50;
  background: rgba(76, 175, 80, 0.15);
  box-shadow: 0 0 8px rgba(76, 175, 80, 0.4);
}

.ch-milestone-death .ch-timeline-dot {
  border-color: #e74c3c;
  background: rgba(231, 76, 60, 0.15);
  box-shadow: 0 0 8px rgba(231, 76, 60, 0.4);
}

.ch-milestone-merge .ch-timeline-dot {
  border-color: #ff9800;
  background: rgba(255, 152, 0, 0.15);
  box-shadow: 0 0 8px rgba(255, 152, 0, 0.4);
}

.ch-timeline-day {
  font-size: 10px;
  color: var(--text-muted);
  margin-bottom: 2px;
}

.ch-timeline-desc {
  font-size: 12px;
  color: var(--text-primary);
}

/* 事件记录 */
.ch-events-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 200px;
  overflow-y: auto;
  padding: 4px;
}

.ch-events-list::-webkit-scrollbar {
  width: 4px;
}

.ch-events-list::-webkit-scrollbar-thumb {
  background: rgba(74, 158, 92, 0.2);
  border-radius: 2px;
}

.ch-event-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  background: var(--bg-input);
  border-radius: 6px;
  font-size: 12px;
}

.ch-event-day {
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 600;
  min-width: 36px;
}

.ch-event-icon {
  font-size: 14px;
  min-width: 18px;
}

.ch-event-desc {
  color: var(--text-primary);
  flex: 1;
}

/* 事件颜色分类 */
.ch-event-ipo {
  border-left: 3px solid #4caf50;
}

.ch-event-crisis {
  border-left: 3px solid #e74c3c;
  background: rgba(231, 76, 60, 0.05);
}

.ch-event-merge {
  border-left: 3px solid #ff9800;
}

/* 空状态 */
.ch-empty {
  text-align: center;
  color: var(--text-muted);
  font-style: italic;
  padding: 16px;
  font-size: 12px;
}

/* 弹窗入场动画 */
.company-history-modal .modal-box {
  animation: companyHistoryPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes companyHistoryPop {
  0% {
    transform: scale(0.85) translateY(-20px);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* 企业 Tab 中的"查看历史书"按钮 */
.ch-history-btn {
  width: 100%;
  margin-top: 10px;
  padding: 8px 12px;
  background: linear-gradient(
    90deg,
    rgba(74, 158, 92, 0.1),
    rgba(74, 158, 92, 0.05)
  );
  border: 1px solid rgba(74, 158, 92, 0.25);
  border-radius: 6px;
  color: var(--accent);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  text-align: center;
}

.ch-history-btn:hover {
  background: linear-gradient(
    90deg,
    rgba(74, 158, 92, 0.18),
    rgba(74, 158, 92, 0.1)
  );
  border-color: var(--accent);
  transform: translateY(-1px);
}

.ch-history-btn:active {
  transform: translateY(0);
}

/* CEO 人格化档案样式 */
.ch-ceo-profile {
  margin: 16px 0;
  padding: 16px;
  background: linear-gradient(
    135deg,
    rgba(124, 58, 237, 0.06),
    rgba(124, 58, 237, 0.02)
  );
  border-radius: 8px;
  border: 1px solid rgba(124, 58, 237, 0.15);
}

.ch-ceo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 12px;
}

.ch-ceo-main {
  padding: 12px;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 6px;
}

.ch-ceo-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 10px;
}

.ch-ceo-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed, #a78bfa);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.ch-ceo-age {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.2);
  padding: 2px 6px;
  border-radius: 10px;
  margin-top: 4px;
}

.ch-ceo-info {
  flex: 1;
}

.ch-ceo-bg {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.ch-ceo-personality {
  font-size: 12px;
  color: var(--text-primary);
  font-style: italic;
}

.ch-ceo-story {
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-secondary);
  margin: 8px 0;
}

.ch-ceo-quote {
  font-size: 12px;
  font-style: italic;
  color: #7c3aed;
  padding: 8px 12px;
  background: rgba(124, 58, 237, 0.08);
  border-radius: 4px;
  border-left: 3px solid #7c3aed;
  margin-top: 8px;
}

.ch-ceo-weakness {
  padding: 12px;
  background: rgba(239, 68, 68, 0.06);
  border-radius: 6px;
  border: 1px solid rgba(239, 68, 68, 0.15);
}

.ch-ceo-weakness p {
  margin: 6px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
}

/* ====== 模式选择 ====== */
.mode-grid {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 600px;
  margin: 0 auto;
}

.mode-card {
  background: var(--bg-card);
  border: 2px solid var(--border);
  border-radius: 12px;
  padding: 20px 16px;
  width: 170px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
}

.mode-card:hover {
  border-color: var(--accent);
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(74, 158, 92, 0.15);
}

.mode-card-icon {
  font-size: 36px;
  margin-bottom: 8px;
}

.mode-card-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.mode-card-brief {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.mode-card-diff {
  font-size: 11px;
  color: var(--text-muted);
}

/* 剧本卡片网格 */
.scenario-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 520px;
  margin: 0 auto;
  text-align: left;
}

.scenario-card {
  background: var(--bg-card);
  border: 2px solid var(--border);
  border-radius: 10px;
  padding: 14px 16px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.scenario-card:hover {
  border-color: var(--accent);
  transform: translateX(3px);
  box-shadow: 0 3px 12px rgba(74, 158, 92, 0.1);
}

.scenario-card-icon {
  font-size: 30px;
  flex-shrink: 0;
  line-height: 1;
}

.scenario-card-body {
  flex: 1;
  min-width: 0;
}

.scenario-card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.scenario-card-brief {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 3px;
  line-height: 1.5;
}

.scenario-card-tags {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  margin-top: 5px;
}

.scenario-card-tag {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 4px;
