## 四、状态 ↔ 基础属性 ↔ 状态 深度互联

### 4.1 新增交互系统文件

**新建 `js/phase1/interactions.js`** — 包含所有交叉影响的计算逻辑

#### 核心函数：
```
getStatusCrossEffects(state) → 返回所有活跃的交叉修正值
getEffectiveStats(state) → 返回经过状态修正后的真实属性值
getApCostMultiplier(state) → 返回当前AP消耗倍率
applyStatusInteractions(state) → 每日结算时调用，施加交叉影响
checkExtremeConditions(state) → 极端状态检测（饿晕/过劳/病危）
```

### 4.2 状态→状态交叉影响（每日结算）

```js
// 在 endDay 的 applyNeedsDecay 之后调用 applyStatusInteractions
function applyStatusInteractions(state) {
  const n = state.needs;
  const st = state.status;
  
  // 饥饿→加速疲劳
  if (n.hunger < 30) n.fatigue = Math.min(100, n.fatigue + 5);
  if (n.hunger < 15) n.fatigue = Math.min(100, n.fatigue + 8);
  
  // 饥饿→心情下降
  if (n.hunger < 20) n.happiness = Math.max(0, n.happiness - 5);
  
  // 疲劳→心情下降
  if (n.fatigue > 70) n.happiness = Math.max(0, n.happiness - 3);
  if (n.fatigue > 85) n.happiness = Math.max(0, n.happiness - 5);
  
  // 疲劳→懒得洗漱
  if (n.fatigue > 85) n.hygiene = Math.max(0, n.hygiene - 3);
  
  // 心情差→疲劳恢复减半
  if (n.happiness < 20) state._fatigueRecoveryPenalty = 0.5; // endDay中乘此系数
  
  // 健康差→疲劳增长
  if (st.health < 30) n.fatigue = Math.min(100, n.fatigue + 5);
  
  // 生病→疲劳+心情
  if (st.sick) { n.fatigue = Math.min(100, n.fatigue + 8); n.happiness = Math.max(0, n.happiness - 5); }
  if (st.injured) { n.fatigue = Math.min(100, n.fatigue + 5); n.happiness = Math.max(0, n.happiness - 3); }
  
  // 高体质→减缓疲劳
  if (state.player.physique > 60) n.fatigue = Math.max(0, n.fatigue - 2);
  
  // 高心智→减缓心情下降
  if (state.player.mental > 60) n.happiness = Math.min(100, n.happiness + 2);
}
```

### 4.3 状态→基础属性修正（实时计算）

```js
function getEffectiveStats(state) {
  const n = state.needs, st = state.status, p = state.player;
  let mult = { physique: 1.0, intelligence: 1.0, agility: 1.0, mental: 1.0 };
  
  // 饥饿影响（饿到没力气/脑子转不动）
  if (n.hunger < 30) { mult.agility *= 0.85; mult.mental *= 0.9; }
  if (n.hunger < 15) { mult.agility *= 0.75; mult.mental *= 0.8; mult.physique *= 0.85; }
  if (n.hunger < 5)  { mult.agility *= 0.5; mult.mental *= 0.5; mult.physique *= 0.6; }
  
  // 疲劳影响
  if (n.fatigue > 70) { mult.agility *= 0.85; mult.mental *= 0.9; }
  if (n.fatigue > 85) { mult.agility *= 0.7; mult.mental *= 0.75; mult.physique *= 0.85; }
  if (n.fatigue > 95) { mult.agility *= 0.5; mult.mental *= 0.5; mult.physique *= 0.7; }
  
  // 健康影响
  if (st.health < 50) { mult.physique *= 0.85; }
  if (st.health < 30) { mult.physique *= 0.7; mult.agility *= 0.85; }
  if (st.health < 15) { mult.physique *= 0.5; mult.agility *= 0.7; mult.intelligence *= 0.85; }
  
  // 心情影响
  if (n.happiness < 20) { mult.mental *= 0.8; mult.intelligence *= 0.9; }
  if (n.happiness < 10) { mult.mental *= 0.6; mult.intelligence *= 0.8; }
  
  // 生病/受伤
  if (st.sick) { mult.physique *= 0.85; mult.agility *= 0.9; mult.mental *= 0.9; }
  if (st.injured) { mult.physique *= 0.75; mult.agility *= 0.7; }
  
  // 高基础属性正向反馈
  if (p.agility > 50) mult.agility *= 1.05;   // 敏捷高→动作更敏捷
  if (p.mental > 50) mult.mental *= 1.05;      // 心智高→抗压
  
  return {
    physique: Math.round(p.physique * Math.max(0.3, mult.physique)),
    intelligence: Math.round(p.intelligence * Math.max(0.3, mult.intelligence)),
    agility: Math.round(p.agility * Math.max(0.3, mult.agility)),
    mental: Math.round(p.mental * Math.max(0.3, mult.mental)),
    multipliers: mult
  };
}
```

### 4.4 AP消耗倍率（实时计算）

```js
function getApCostMultiplier(state) {
  const n = state.needs, st = state.status, p = state.player;
  let mult = 1.0;
  
  if (n.fatigue > 70) mult += 0.2;
  if (n.fatigue > 85) mult += 0.25;  // 累计+0.45
  if (n.fatigue > 95) mult += 0.35;  // 累计+0.8
  
  if (n.hunger < 20) mult += 0.3;
  if (n.hunger < 10) mult += 0.2;    // 累计+0.5
  
  if (st.sick) mult += 0.5;
  if (st.injured) mult += 0.3;
  
  if (n.happiness < 15) mult += 0.2;
  
  // 高敏捷减免
  if (p.agility > 50) mult -= 0.1;
  if (p.agility > 75) mult -= 0.1;   // 累计-0.2
  
  // 保底：AP消耗至少为原始的50%，最多为200%
  return Math.max(0.5, Math.min(2.0, mult));
}
```

**使用方式**：修改 `js/main.js` 的 `consumeAP()` → `const actualCost = Math.round(cost * getApCostMultiplier(state))`

### 4.5 极端状态触发

```js
function checkExtremeConditions(state) {
  const n = state.needs, st = state.status;
  
  // 饿晕 → 跳过一整天
  if (n.hunger <= 5) {
    StateManager.addMessage("💀 你饿晕在街头，醒来已经是第二天了...健康严重受损！", "danger");
    st.health = Math.max(0, st.health - 15);
    n.hunger = 10; // 好心人给了点吃的
    n.fatigue = Math.min(100, n.fatigue + 20);
    n.happiness = Math.max(0, n.happiness - 20);
    // 强制结束当天（跳过所有剩余行动）
    return 'skip_day';
  }
  
  // 过劳 → 强制结束当天
  if (n.fatigue >= 98) {
    StateManager.addMessage("😵 你累倒了！身体撑不住了...", "danger");
    st.health = Math.max(0, st.health - 10);
    st.sick = true; // 过劳生病
    return 'skip_day';
  }
  
  // 病危送医
  if (st.health <= 5 && !state.flags._forcedHospital) {
    state.flags._forcedHospital = true;
    if (state.resources.cash >= 500) {
      state.resources.cash -= 500;
      st.health = Math.min(50, st.health + 20);
      StateManager.addMessage("🏥 你被好心人送进医院，花了¥500急救...", "warning");
    } else {
      StateManager.addMessage("🏥 你病危被送医，但付不起医药费...欠下¥500", "danger");
      state.resources.bankDebt += 500;
      state.resources.debt += 500;
      st.health = Math.min(30, st.health + 10);
    }
  }
  
  // 重置医院标记（健康恢复到>20后）
  if (st.health > 20) state.flags._forcedHospital = false;
  
  return null; // 正常
}
```

### 4.6 修改 endDay 流程

**修改文件**: `js/main.js` 的 `endDay()`

在现有流程中插入：
1. `applyNeedsDecay()` 之后 → 调用 `applyStatusInteractions(state)`
2. 睡眠恢复时应用 `_fatigueRecoveryPenalty`（心情差恢复减半）
3. 在健康结算之后 → 调用 `checkExtremeConditions(state)`
4. 如果返回 `'skip_day'`，直接跳到次日（不执行价格更新/投资tick/新闻等日常事件），但利息和自动存档仍然执行

