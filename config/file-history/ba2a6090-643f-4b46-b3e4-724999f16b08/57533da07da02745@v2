        st.player.corporate.upwardMgmt = Math.min(100, st.player.corporate.upwardMgmt + 12);
        st.player.corporate.popularity = Math.min(100, st.player.corporate.popularity + 3);
        st.player.corporate.dignity = Math.max(0, st.player.corporate.dignity - 3);
