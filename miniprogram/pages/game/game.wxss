.container {
  min-height: 100vh;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.loading-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.error-icon {
  font-size: 72rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.retry-btn {
  margin-top: 20rpx;
  padding: 16rpx 60rpx;
  background: #4a9e5c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
