.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%);
  color: #fff;
  padding: 40rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.hero-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 36rpx;
  margin-bottom: 30rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #6bbf7c;
  letter-spacing: 4rpx;
  margin-bottom: 30rpx;
}

.hero-motto {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.6;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #6bbf7c, #4a9e5c);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.8);
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.btn-secondary:active {
  border-color: #6bbf7c;
  color: #6bbf7c;
}

.footer {
  position: fixed;
  bottom: 60rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}
