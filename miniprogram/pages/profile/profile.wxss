.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%);
  color: #fff;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(75, 158, 92, 0.4);
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.stats-grid {
  width: 100%;
  display: flex;
  justify-content: space-around;
  margin-bottom: 60rpx;
  padding: 40rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6bbf7c;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.actions {
  width: 100%;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 44rpx;
  margin-bottom: 20rpx;
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.footer {
  position: fixed;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.version {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.copyright {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.2);
}
